# =============================================================================
# OPÇÃO 1: Execução Local com Docker Compose (PostgreSQL embutido)
# =============================================================================
DATABASE_URL="postgresql://wattflow:wattflow_password@localhost:5432/wattflow?schema=public"
DIRECT_URL="postgresql://wattflow:wattflow_password@localhost:5432/wattflow?schema=public"

# =============================================================================
# OPÇÃO 2: Supabase na Nuvem (Substitua se usar Supabase Cloud)
# =============================================================================
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# =============================================================================
# Configurações do Orquestrador e Autenticação
# =============================================================================
AUTH_SECRET="wattflow_secure_production_auth_secret_key_random_64_bits_abc123"
CRON_SECRET_TOKEN="wattflow_secret_token_123"
SYNC_INTERVAL_SECONDS="60"
PORT="3000"
