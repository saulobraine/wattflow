# =============================================================================
# WattFlow - Variáveis de Ambiente de Produção (VPS com CloudPanel)
# =============================================================================

# Ambiente e Portas
NODE_ENV=production
PORT=3000
APP_BIND_IP=127.0.0.1
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# Banco de Dados PostgreSQL Local
POSTGRES_USER=wattflow
POSTGRES_PASSWORD=gere_uma_senha_forte_para_o_banco_aqui
POSTGRES_DB=wattflow

# URLs do Prisma (usando a rede interna do Docker "postgres:5432")
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Chave Secreta de Sessão (Gerar com: openssl rand -hex 32)
AUTH_SECRET=insira_aqui_uma_chave_hex_aleatoria_com_pelo_menos_64_caracteres

# Token do Agendador de Sincronização (Cron Sync)
CRON_SECRET_TOKEN=insira_um_token_secreto_para_o_cron_disparar_o_sync

# Intervalo do Cron em Segundos (30s ou 60s recomendado para EcoFlow)
SYNC_INTERVAL_SECONDS=60
