datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id                      String             @id @default(uuid())
  email                   String             @unique
  passwordHash            String
  fullName                String?
  twoFactorEnabled        Boolean            @default(false)
  twoFactorSecret         String?
  pendingTwoFactorSecret  String?
  lastTotpCounter         Int?
  tokenVersion            Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  userConfiguration       UserConfiguration?
  passkeys                UserPasskey[]

  @@map("users")
}

model UserPasskey {
  id           String    @id @default(uuid())
  userId       String
  name         String    @default("Passkey")
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_passkeys")
}

model UserConfiguration {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tuyaAccessId         String             @default("")
  tuyaAccessSecret     String             @default("")
  tuyaDeviceId         String             @default("")
  tuyaEndpointRegion   String             @default("https://openapi.tuyaus.com")
  ecoflowEndpointRegion String            @default("https://api.ecoflow.com")
  ecoflowAccessKey     String             @default("")
  ecoflowAccessSecret  String             @default("")
  ecoflowSerialNumber String             @default("")
  turnOnThreshold      Int                @default(90)
  turnOffThreshold     Int                @default(30)
  isAutomationActive   Boolean            @default(true)
  atsLifespanCycles    Int                @default(10000)
  atsCurrentCycles     Int                @default(0)
  atsLastSwitchedAt    DateTime?
  energyCostPerKwh     Float              @default(0.92)
  currencySymbol       String             @default("R$")
  batteryCapacityWh    Int                @default(2048)
  isStormModeActive    Boolean            @default(false)
  isDailyReportActive  Boolean            @default(true)
  dailyReportTime      String             @default("21:00")
  lastDailyReportSentAt DateTime?
  latitude             Float?
  longitude            Float?
  isAdaptiveHysteresisActive Boolean        @default(false)
  minAdaptiveThreshold Int                @default(20)
  maxAdaptiveThreshold Int                @default(50)
  lastSolarIrradianceMj Float?
  lastSolarForecastCheckAt DateTime?
  thermalWarningThreshold Float           @default(42.0)
  thermalShutdownThreshold Float          @default(48.0)
  isThermalProtectionActive  Boolean        @default(true)
  thermalThrottleTempThreshold Int          @default(42)
  thermalCutoffTempThreshold   Int          @default(48)
  thermalRecoveryTempThreshold Int          @default(44)
  thermalThrottleSpeedWatts    Int          @default(200)
  isThermalThrottleActive    Boolean        @default(false)
  isThermalCutoffActive      Boolean        @default(false)
  lastThermalEventAt         DateTime?
  lastThermalActionMessage   String?
  lastBatteryTempCelsius Float?
  lastBatterySoh       Int?
  lastBatteryCycles    Int?
  maxRecordedBatteryTemp Float?
  isDynamicTariffActive      Boolean            @default(false)
  peakTariffPerKwh           Float              @default(1.85)
  intermediateTariffPerKwh   Float              @default(1.15)
  offPeakTariffPerKwh        Float              @default(0.65)
  peakStartTime              String             @default("17:30")
  peakEndTime                String             @default("20:30")
  intermediateStartTime1     String             @default("16:30")
  intermediateEndTime1       String             @default("17:30")
  intermediateStartTime2     String             @default("20:30")
  intermediateEndTime2       String             @default("21:30")
  intermediateStartTime      String?            @default("16:30")
  intermediateEndTime        String?            @default("21:30")
  peakReserveThreshold       Int                @default(15)
  peakDischargeReserveLimit  Int                @default(20)
  isTimeOfUseActive          Boolean            @default(false)
  timeOfUseWeekdaysOnly      Boolean            @default(true)
  blockAcChargingDuringPeak  Boolean            @default(true)
  inverterMaxWatts           Int                @default(2400)
  isAlertOnBlackout          Boolean            @default(true)
  isAlertOnGridRestore       Boolean            @default(true)
  isAlertOnOverload          Boolean            @default(true)
  isAlertOnThermalRisk       Boolean            @default(true)
  isAlertOnAtsFailure        Boolean            @default(true)
  alertCooldownMinutes       Int                @default(10)
  isSmartChargingActive      Boolean            @default(false)
  minAcChargingWatts         Int                @default(200)
  maxAcChargingWatts         Int                @default(1200)
  currentAcChargingWatts     Int                @default(400)
  chargeOnlyOffPeak          Boolean            @default(true)
  cloudyPrechargeActive      Boolean            @default(true)
  lastSmartChargeAdjustAt    DateTime?
  isAutoStormActive          Boolean            @default(false)
  autoStormReserveThreshold  Int                @default(85)
  autoStormRainThresholdMm   Float              @default(20.0)
  autoStormPrechargeAc       Boolean            @default(true)
  isStormAlertActive         Boolean            @default(false)
  lastStormAlertCode         Int?
  lastStormAlertDescription  String?
  lastStormAlertTriggeredAt  DateTime?
  lastStormAlertEndedAt      DateTime?
  applianceProfiles          ApplianceLoadProfile[]
  telegramBotToken     String             @default("")
  telegramChatId       String             @default("")
  whatsappPhoneNumber  String             @default("")
  whatsappApiKey       String             @default("")
  isNotificationActive Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  syncExecutionLogs    SyncExecutionLog[]

  @@map("user_configurations")
}

model ApplianceLoadProfile {
  id                   String            @id @default(uuid())
  userConfigurationId  String
  name                 String
  category             String            @default("ESSENTIAL")
  averageWatts         Int
  isActiveInSimulation Boolean           @default(false)
  icon                 String            @default("Zap")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  userConfiguration    UserConfiguration @relation(fields: [userConfigurationId], references: [id], onDelete: Cascade)

  @@map("appliance_load_profiles")
}

model SyncExecutionLog {
  id                  String            @id @default(uuid())
  userConfigurationId String
  batteryPercentage   Int
  solarInputWatts     Int               @default(0)
  outputWatts         Int               @default(0)
  batteryTempCelsius  Float?
  batterySoh          Int?
  batteryCycles       Int?
  actionTriggered     String
  executionDetails    String?
  executedAt          DateTime          @default(now())
  userConfiguration   UserConfiguration @relation(fields: [userConfigurationId], references: [id], onDelete: Cascade)

  @@index([userConfigurationId, executedAt])
  @@index([executedAt])
  @@map("sync_execution_logs")
}
